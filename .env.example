# =============================================
# ATRIO — Environment Variables Template
# =============================================
# Copy this file to `.env` and fill in the real values.
# DO NOT commit `.env` — it is gitignored.
#
# Even though Flutter apps can't keep secrets perfectly (anyone can
# decompile the APK), values in `.env` are still better than hard-coding
# strings in source. ANY value here will be visible in the bundled app.
#
# RULES:
#   - Use ANON / PUBLIC keys only. Server secrets go in Supabase Edge
#     Functions, never here.
#   - Never put SUPABASE_SERVICE_ROLE_KEY in this file.
#   - Never put MP production access tokens in this file. Move payment
#     creation to a Supabase Edge Function (see supabase/functions/).
# =============================================

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Google Maps (restrict by SHA-1 + package name in GCP Console) ──
GOOGLE_MAPS_API_KEY=AIzaSy_REPLACE_ME

# ── Mercado Pago ─────────────────────────────
# Only the PUBLIC key is allowed in the app bundle. The access token is
# server-only and lives in `supabase/functions/mp-webhook/.env`.
MP_PUBLIC_KEY=APP_USR-REPLACE_ME
MP_SANDBOX=true

# Edge Function endpoints (created in #2 below):
MP_CREATE_PREFERENCE_URL=https://your-project.supabase.co/functions/v1/mp-create-preference
MP_WEBHOOK_PUBLIC_URL=https://your-project.supabase.co/functions/v1/mp-webhook
